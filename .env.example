# Solana settings for Kerb.
#
# The site is static and reads config/kerb.config.json in the browser. These
# variables do nothing on their own: copy this file to .env, fill it in, then
#
#     python tools/solana-env.py
#
# to write the values into the JSON, and commit the JSON. Everything here ends
# up public, so nothing secret belongs in it.

# mainnet-beta, devnet or testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Required for balances on mainnet: api.mainnet-beta.solana.com refuses browser
# requests. Use a provider endpoint whose key is restricted to this domain.
NEXT_PUBLIC_SOLANA_RPC_URL=

NEXT_PUBLIC_EXPLORER_BASE_URL=https://explorer.solana.com

# The Kerb SPL token mint. Empty shows `Coming Soon`.
NEXT_PUBLIC_KERB_TOKEN_MINT=
NEXT_PUBLIC_KERB_TOKEN_SYMBOL=KERB

# The Kerb program is not deployed. Leave empty until it is; empty shows
# `Not deployed`. Do not put a placeholder key here.
NEXT_PUBLIC_KERB_PROGRAM_ID=

NEXT_PUBLIC_TREASURY_ADDRESS=
